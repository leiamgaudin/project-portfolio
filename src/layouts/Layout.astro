---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Leiam Gaudin | Mechanical Design & Dimensional Engineer",
  description = "Mechanical Engineering student at Purdue University with engineering experience at Tesla, American Water, Estes Design, and Purdue Electric Racing.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0c0c0e" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://leiamgaudin.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    
    <!-- Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
      body {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      }
    </style>
  </head>
  <body class="min-h-screen relative overflow-x-hidden bg-[#0c0c0e] text-[#f5f5f7]">
    <!-- Mobile-optimized subtle background glow using hardware-accelerated transforms and opacity -->
    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[600px] sm:w-[900px] h-[350px] sm:h-[450px] bg-gradient-to-b from-blue-600/10 via-indigo-600/5 to-transparent blur-[60px] sm:blur-[100px] pointer-events-none -z-10 transform-gpu"></div>
    <div class="fixed bottom-0 right-0 w-[300px] sm:w-[500px] h-[300px] sm:h-[400px] bg-gradient-to-t from-emerald-600/5 to-transparent blur-[60px] sm:blur-[100px] pointer-events-none -z-10 transform-gpu"></div>

    <slot />
  </body>
</html>
