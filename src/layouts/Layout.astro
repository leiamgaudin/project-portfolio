---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Leiam Gaudin | Mechanical Design & Dimensional Engineer",
  description = "Mechanical Engineering student at Purdue University with engineering experience at Tesla, American Water, Estes Design, and Purdue Electric Racing.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#f8f9fa" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://leiamgaudin.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    
    <!-- Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
      body {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      }
    </style>

    <!-- Theme Initialization Script to Prevent Flash -->
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="min-h-screen relative overflow-x-hidden selection:bg-blue-600/20 selection:text-blue-900 dark:selection:bg-blue-500/30 dark:selection:text-white">
    <!-- Ambient vibrant gradient orbs that shine through translucent glass buttons & cards -->
    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[700px] sm:w-[1100px] h-[400px] sm:h-[550px] bg-gradient-to-b from-blue-500/25 via-indigo-500/20 to-transparent dark:from-blue-600/20 dark:via-indigo-600/15 blur-[90px] sm:blur-[130px] pointer-events-none -z-10 transform-gpu"></div>
    <div class="fixed top-1/3 -left-40 w-[500px] h-[500px] bg-gradient-to-r from-purple-500/15 via-pink-500/10 to-transparent dark:from-purple-600/15 dark:via-pink-600/10 blur-[110px] pointer-events-none -z-10 transform-gpu"></div>
    <div class="fixed bottom-0 right-0 w-[400px] sm:w-[650px] h-[400px] sm:h-[550px] bg-gradient-to-t from-emerald-400/25 via-teal-400/15 to-transparent dark:from-emerald-500/15 dark:via-teal-500/10 blur-[90px] sm:blur-[140px] pointer-events-none -z-10 transform-gpu"></div>

    <slot />
  </body>
</html>
