<header class="fixed top-0 left-0 right-0 z-50 px-4 sm:px-6 py-4 transition-all duration-300">
  <div class="max-w-5xl mx-auto flex items-center justify-between px-5 py-3 rounded-full apple-glass border border-white/10 shadow-lg shadow-black/30">
    <a href="#" class="group flex items-center gap-2">
      <div class="w-7 h-7 rounded-full bg-white/10 flex items-center justify-center font-bold text-xs tracking-wider text-white group-hover:bg-blue-600 transition-colors">
        LG
      </div>
      <span class="font-medium text-sm text-neutral-200 group-hover:text-white transition-colors">Leiam Gaudin</span>
    </a>

    <nav class="hidden md:flex items-center gap-6 text-sm text-neutral-400">
      <a href="#about" class="hover:text-white transition-colors">About</a>
      <a href="#experience" class="hover:text-white transition-colors">Experience</a>
      <a href="#projects" class="hover:text-white transition-colors">Projects</a>
      <a href="#skills" class="hover:text-white transition-colors">Skills</a>
    </nav>

    <div class="flex items-center gap-3">
      <button 
        type="button"
        data-contact-trigger
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white text-neutral-950 font-medium text-xs hover:bg-neutral-200 transition-all shadow-sm hover:scale-[1.02] active:scale-[0.98] cursor-pointer"
