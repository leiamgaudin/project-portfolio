---
---

<section id="about" class="pt-36 pb-20 px-4 sm:px-6 max-w-5xl mx-auto">
  <div class="space-y-6">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold tracking-wide">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      Available for Summer Internships & Full-Time Roles Starting January 2027
    </div>

    <div class="space-y-3">
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight text-white leading-[1.08]">
        Mechanical Design & <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-300 to-white">
          Dimensional Engineer
        </span>
      </h1>
      <p class="text-lg sm:text-xl text-neutral-400 max-w-2xl font-normal leading-relaxed pt-2">
        Hi, I'm <strong class="text-white font-medium">Leiam Gaudin</strong>. Mechanical Engineering student at <strong class="text-neutral-200 font-medium">Purdue University</strong> (GPA 3.57, Exp. Dec 2027), previously at <strong class="text-neutral-200 font-medium">Tesla</strong> (Dimensional Engineering), <strong class="text-neutral-200 font-medium">Estes Design</strong>, and <strong class="text-neutral-200 font-medium">American Water</strong>.
      </p>
    </div>

    <!-- Quick Action Bar / Direct Recruiter Links -->
    <div class="pt-4 flex flex-wrap items-center gap-3">
      <!-- Contact Popup Button -->
      <button 
        type="button"
        data-contact-trigger
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white text-neutral-950 font-semibold text-sm hover:bg-neutral-100 transition-all shadow-md shadow-white/5 hover:scale-[1.02] active:scale-[0.98] cursor-pointer"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-neutral-900" viewBox="0 0 20 20" fill="currentColor">
          <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
          <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
        </svg>
        <span>Contact Me</span>
      </button>

      <!-- Primary Email Direct Link -->
      <a 
        href="mailto:leiamgaudin@gmail.com" 
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-white/10 hover:bg-white/15 text-white font-medium text-sm border border-white/10 transition-all hover:scale-[1.02]"
      >
        <span>leiamgaudin@gmail.com</span>
      </a>

      <!-- LinkedIn -->
      <a 
        href="https://linkedin.com/in/leiam-gaudin" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-white/10 hover:bg-white/15 text-white font-medium text-sm border border-white/10 transition-all hover:scale-[1.02]"
      >
        <svg class="w-4 h-4 fill-current text-blue-400" viewBox="0 0 24 24">
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
        </svg>
        <span>LinkedIn</span>
      </a>

      <!-- Resume PDF Download -->
      <a 
        href="/assets/docs/Leiam_Gaudin_Resume.pdf" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-neutral-900 hover:bg-neutral-800 text-neutral-300 hover:text-white font-medium text-sm border border-white/10 transition-all hover:scale-[1.02]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>Download Resume</span>
      </a>
    </div>

    <!-- Highlights Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 pt-8 border-t border-white/10">
      <div class="p-4 rounded-2xl apple-card">
        <div class="text-2xl font-bold text-white tracking-tight">Tesla</div>
        <div class="text-xs text-neutral-400 mt-1">Dimensional Eng. Intern (Megapack)</div>
      </div>
      <div class="p-4 rounded-2xl apple-card">
        <div class="text-2xl font-bold text-white tracking-tight">1200%</div>
        <div class="text-xs text-neutral-400 mt-1">CATIA Sim Workflow Speedup</div>
      </div>
      <div class="p-4 rounded-2xl apple-card">
        <div class="text-2xl font-bold text-white tracking-tight">0.25 → 2.25</div>
        <div class="text-xs text-neutral-400 mt-1">Cpk Beam Structural Optimization</div>
      </div>
      <div class="p-4 rounded-2xl apple-card">
        <div class="text-2xl font-bold text-white tracking-tight">Purdue '27</div>
        <div class="text-xs text-neutral-400 mt-1">B.S. Mechanical Engineering</div>
      </div>
    </div>
  </div>
</section>
