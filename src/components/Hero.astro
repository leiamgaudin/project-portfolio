---
---

<section id="about" class="pt-36 pb-20 px-4 sm:px-6 max-w-5xl mx-auto">
  <div class="space-y-6">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-600 dark:text-blue-400 text-xs font-semibold tracking-wide">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      Available for Summer Internships & Full-Time Roles Starting January 2028
    </div>

    <div class="space-y-3">
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-bold tracking-tight text-neutral-900 dark:text-white leading-[1.08]">
        Mechanical Design & <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-indigo-600 to-neutral-900 dark:from-blue-400 dark:via-indigo-300 dark:to-white">
          Dimensional Engineer
        </span>
      </h1>
      <p class="text-lg sm:text-xl text-neutral-600 dark:text-neutral-400 max-w-2xl font-normal leading-relaxed pt-2">
        Hi, I'm <strong class="text-neutral-900 dark:text-white font-semibold">Leiam Gaudin</strong>. Mechanical Engineering student at <strong class="text-neutral-800 dark:text-neutral-200 font-semibold">Purdue University</strong> (GPA 3.57, Exp. Dec 2027), with industry engineering experience at <strong class="text-neutral-800 dark:text-neutral-200 font-semibold">Tesla</strong> (Dimensional Engineering), <strong class="text-neutral-800 dark:text-neutral-200 font-semibold">American Water</strong>, and <strong class="text-neutral-800 dark:text-neutral-200 font-semibold">Estes Design</strong>.
      </p>
    </div>

    <!-- Quick Action Bar / Apple Glass Buttons -->
    <div class="pt-4 flex flex-wrap items-center gap-3">
      <!-- Contact Popup Button -->
      <button 
        type="button"
        data-contact-trigger
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full glass-btn-primary font-semibold text-sm cursor-pointer active:scale-[0.98]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
          <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
          <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
        </svg>
        <span>Contact Me</span>
      </button>

      <!-- LinkedIn -->
      <a 
        href="https://linkedin.com/in/leiam-gaudin" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full glass-btn font-medium text-sm text-neutral-800 dark:text-white"
      >
        <svg class="w-4 h-4 fill-current text-[#0a66c2]" viewBox="0 0 24 24">
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
        </svg>
        <span>LinkedIn</span>
      </a>

      <!-- GitHub -->
      <a 
        href="https://github.com/leiamgaudin" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full glass-btn font-medium text-sm text-neutral-800 dark:text-white"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span>GitHub</span>
      </a>

      <!-- Resume PDF Download -->
      <a 
        href="/assets/docs/Leiam_Gaudin_Resume.pdf?v=2" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full glass-btn font-medium text-sm text-neutral-800 dark:text-white"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-neutral-500 dark:text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>Download Resume</span>
      </a>
    </div>

    <!-- Career Highlights Grid (Past Places Worked in Chronological Order) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 pt-8 border-t border-neutral-200 dark:border-white/10">
      <!-- 1. Tesla -->
      <a href="#experience" class="p-4 rounded-2xl apple-card block group">
        <div class="flex items-center justify-between">
          <span class="text-xs font-mono text-blue-600 dark:text-blue-400">8/26 – Present</span>
          <span class="text-[10px] uppercase font-semibold tracking-wider text-neutral-400">Most Recent</span>
        </div>
        <div class="text-xl font-bold text-neutral-900 dark:text-white tracking-tight mt-1 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
          Tesla, Inc.
        </div>
        <div class="text-xs text-neutral-600 dark:text-neutral-400 mt-1 leading-snug">
          Dimensional Engineering Intern <br />
          <span class="text-neutral-400 dark:text-neutral-500">Palo Alto, CA • Megapack NE42</span>
        </div>
      </a>

      <!-- 2. American Water -->
      <a href="#experience" class="p-4 rounded-2xl apple-card block group">
        <div class="flex items-center justify-between">
          <span class="text-xs font-mono text-blue-600 dark:text-blue-400">5/26 – 8/26</span>
          <span class="text-[10px] uppercase font-semibold tracking-wider text-neutral-400">Internship</span>
        </div>
        <div class="text-xl font-bold text-neutral-900 dark:text-white tracking-tight mt-1 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
          American Water
        </div>
        <div class="text-xs text-neutral-600 dark:text-neutral-400 mt-1 leading-snug">
          Engineering Project Mgmt Intern <br />
          <span class="text-neutral-400 dark:text-neutral-500">Indianapolis, IN • $2M+ Projects</span>
        </div>
      </a>

      <!-- 3. Estes Design -->
      <a href="#experience" class="p-4 rounded-2xl apple-card block group">
        <div class="flex items-center justify-between">
          <span class="text-xs font-mono text-blue-600 dark:text-blue-400">5/25 – 8/25</span>
          <span class="text-[10px] uppercase font-semibold tracking-wider text-neutral-400">Internship</span>
        </div>
        <div class="text-xl font-bold text-neutral-900 dark:text-white tracking-tight mt-1 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
          Estes Design & Mfg.
        </div>
        <div class="text-xs text-neutral-600 dark:text-neutral-400 mt-1 leading-snug">
          Mechanical Engineering Intern <br />
          <span class="text-neutral-400 dark:text-neutral-500">Sheet Metal DFM • 3D Tooling</span>
        </div>
      </a>

      <!-- 4. Purdue Electric Racing -->
      <a href="#experience" class="p-4 rounded-2xl apple-card block group">
        <div class="flex items-center justify-between">
          <span class="text-xs font-mono text-blue-600 dark:text-blue-400">1/26 – Present</span>
          <span class="text-[10px] uppercase font-semibold tracking-wider text-neutral-400">Formula SAE</span>
        </div>
        <div class="text-xl font-bold text-neutral-900 dark:text-white tracking-tight mt-1 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
          Purdue Formula SAE
        </div>
        <div class="text-xs text-neutral-600 dark:text-neutral-400 mt-1 leading-snug">
          Drivetrain Engineer <br />
          <span class="text-neutral-400 dark:text-neutral-500">Planetary Gearboxes • Machining</span>
        </div>
      </a>
    </div>
  </div>
</section>
