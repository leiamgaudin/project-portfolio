---
---

<div id="contact-modal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4 sm:p-6">
  <div id="contact-modal-backdrop" class="fixed inset-0 bg-black/60 dark:bg-black/80 backdrop-blur-xl transition-opacity"></div>

  <div class="relative w-full max-w-md bg-white dark:bg-[#16161b] border border-black/10 dark:border-white/10 rounded-3xl p-7 shadow-2xl z-10 animate-in fade-in zoom-in-95 duration-200 space-y-6 text-neutral-900 dark:text-white">
    <div class="flex items-center justify-between border-b border-neutral-200 dark:border-white/10 pb-4">
      <div>
        <h3 class="text-xl font-bold tracking-tight">Get in Touch</h3>
        <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">Feel free to connect or drop me an email</p>
      </div>
      <button id="contact-modal-close" class="p-2 rounded-full bg-black/5 dark:bg-white/10 hover:bg-black/10 dark:hover:bg-white/20 text-neutral-700 dark:text-neutral-300 hover:text-black dark:hover:text-white transition-colors cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="space-y-3">
      <!-- Email Card with 1-click copy -->
      <div class="p-4 rounded-2xl bg-black/[0.03] dark:bg-white/5 border border-black/5 dark:border-white/10 space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs text-neutral-500 dark:text-neutral-400 uppercase tracking-wider font-semibold">Direct Email</span>
          <span id="copy-status" class="text-[11px] text-emerald-600 dark:text-emerald-400 font-semibold hidden">Copied to clipboard!</span>
        </div>
        <div class="flex items-center justify-between gap-2">
          <span class="text-sm font-medium select-all">leiamgaudin@gmail.com</span>
          <div class="flex items-center gap-1.5">
            <button 
              id="copy-email-btn"
              title="Copy Email"
              class="px-2.5 py-1.5 rounded-lg glass-btn text-xs font-medium cursor-pointer"
            >
              Copy
            </button>
            <a 
              href="mailto:leiamgaudin@gmail.com"
              class="px-2.5 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-xs font-medium transition-colors"
            >
              Mail
            </a>
          </div>
        </div>
      </div>

      <!-- LinkedIn Card -->
      <a 
        href="https://linkedin.com/in/leiam-gaudin" 
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center justify-between p-4 rounded-2xl bg-black/[0.03] dark:bg-white/5 hover:bg-black/[0.06] dark:hover:bg-white/10 border border-black/5 dark:border-white/10 transition-all group"
      >
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-[#0a66c2] dark:text-blue-400">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </div>
          <div>
            <div class="text-sm font-semibold group-hover:text-blue-600 dark:group-hover:text-blue-300 transition-colors">LinkedIn Profile</div>
            <div class="text-xs text-neutral-500 dark:text-neutral-400">linkedin.com/in/leiam-gaudin</div>
          </div>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-neutral-400 group-hover:translate-x-0.5 group-hover:text-neutral-900 dark:group-hover:text-white transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>

      <!-- GitHub Profile Card -->
      <a 
        href="https://github.com/leiamgaudin" 
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center justify-between p-4 rounded-2xl bg-black/[0.03] dark:bg-white/5 hover:bg-black/[0.06] dark:hover:bg-white/10 border border-black/5 dark:border-white/10 transition-all group"
      >
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-neutral-500/10 border border-neutral-500/20 flex items-center justify-center text-neutral-800 dark:text-neutral-200">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
          </div>
          <div>
            <div class="text-sm font-semibold group-hover:text-blue-600 dark:group-hover:text-blue-300 transition-colors">GitHub Profile</div>
            <div class="text-xs text-neutral-500 dark:text-neutral-400">github.com/leiamgaudin</div>
          </div>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-neutral-400 group-hover:translate-x-0.5 group-hover:text-neutral-900 dark:group-hover:text-white transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>

      <!-- Resume Download -->
      <a 
        href="/assets/docs/Leiam_Gaudin_Resume.pdf?v=2" 
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center justify-between p-4 rounded-2xl bg-black/[0.03] dark:bg-white/5 hover:bg-black/[0.06] dark:hover:bg-white/10 border border-black/5 dark:border-white/10 transition-all group"
      >
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-600 dark:text-purple-400">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <div>
            <div class="text-sm font-semibold group-hover:text-purple-600 dark:group-hover:text-purple-300 transition-colors">Resume PDF</div>
            <div class="text-xs text-neutral-500 dark:text-neutral-400">View or download latest copy</div>
          </div>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-neutral-400 group-hover:translate-x-0.5 group-hover:text-neutral-900 dark:group-hover:text-white transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>
</div>

<script>
  const contactModal = document.getElementById('contact-modal');
  const contactBackdrop = document.getElementById('contact-modal-backdrop');
  const contactClose = document.getElementById('contact-modal-close');
  const copyBtn = document.getElementById('copy-email-btn');
  const copyStatus = document.getElementById('copy-status');

  function openContactModal() {
    contactModal?.classList.remove('hidden');
    contactModal?.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeContactModal() {
    contactModal?.classList.add('hidden');
    contactModal?.classList.remove('flex');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('[data-contact-trigger]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      openContactModal();
    });
  });

  contactClose?.addEventListener('click', closeContactModal);
  contactBackdrop?.addEventListener('click', closeContactModal);

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText('leiamgaudin@gmail.com');
      if (copyStatus) {
        copyStatus.classList.remove('hidden');
        setTimeout(() => copyStatus.classList.add('hidden'), 2500);
      }
    } catch (e) {
      // fallback
    }
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !contactModal?.classList.contains('hidden')) {
      closeContactModal();
    }
  });
</script>
