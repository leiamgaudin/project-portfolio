---
---

<footer id="contact" class="pt-20 pb-16 px-4 sm:px-6 border-t border-white/10 relative overflow-hidden">
  <div class="max-w-5xl mx-auto space-y-12">
    <!-- Big Apple-style Call to Action Card -->
    <div class="rounded-3xl p-8 sm:p-12 apple-card relative overflow-hidden bg-gradient-to-b from-white/[0.07] to-white/[0.02]">
      <div class="relative z-10 max-w-2xl space-y-4">
        <span class="text-xs font-semibold uppercase tracking-wider text-blue-400">Let's Connect</span>
        <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-white leading-tight">
          Interested in working together or discussing engineering roles?
        </h2>
        <p class="text-neutral-300 text-base font-normal leading-relaxed">
          I'm currently exploring summer internships and full-time engineering roles starting January 2028 in mechanical design, dimensional engineering, robotics, and hardware systems.
        </p>

        <!-- Direct Contact Action Buttons -->
        <div class="pt-6 flex flex-wrap items-center gap-3">
          <!-- Primary Contact Button -->
          <button 
            type="button"
            data-contact-trigger
            class="inline-flex items-center gap-2.5 px-6 py-3 rounded-full bg-white text-neutral-950 font-semibold text-sm hover:bg-neutral-100 transition-all shadow-lg shadow-white/5 hover:scale-[1.02] active:scale-[0.98] cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-neutral-900" viewBox="0 0 20 20" fill="currentColor">
              <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
              <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
            </svg>
            <span>Contact Me</span>
          </button>

          <!-- Direct Email Link -->
          <a 
            href="mailto:leiamgaudin@gmail.com" 
            class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-white/10 hover:bg-white/15 text-white font-medium text-sm border border-white/10 transition-all hover:scale-[1.02]"
          >
            <span>leiamgaudin@gmail.com</span>
          </a>

          <!-- LinkedIn -->
          <a 
            href="https://linkedin.com/in/leiam-gaudin" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-white/10 hover:bg-white/15 text-white font-medium text-sm border border-white/10 transition-all hover:scale-[1.02]"
          >
            <svg class="w-4 h-4 fill-current text-blue-400" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            <span>LinkedIn Profile</span>
          </a>
        </div>
      </div>

      <!-- Subtle background graphic -->
      <div class="absolute -right-20 -bottom-20 w-80 h-80 rounded-full bg-blue-500/10 blur-3xl pointer-events-none"></div>
    </div>

    <!-- Bottom copyright and links -->
    <div class="flex flex-col sm:flex-row items-center justify-between text-xs text-neutral-500 gap-4 pt-4">
      <div>
        © {new Date().getFullYear()} Leiam Gaudin.
      </div>
      <div class="flex items-center gap-6">
        <a href="#about" class="hover:text-neutral-300 transition-colors">Back to top ↑</a>
        <a href="/assets/docs/Leiam_Gaudin_Resume.pdf" target="_blank" class="hover:text-neutral-300 transition-colors">Resume PDF</a>
        <a href="/assets/docs/Project_Portfolio.pdf" target="_blank" class="hover:text-neutral-300 transition-colors">Presentation Slides PDF</a>
      </div>
    </div>
  </div>
</footer>
